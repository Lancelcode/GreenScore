# ── Error pages ──────────────────────────────────────────────
# Paths are from the web root. If GreenScore is served from a sub-folder
# (e.g. http://localhost/GreenScore/), prefix them with that folder.
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php

# ── Security headers (backup for responses not produced by PHP) ─
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

Options -Indexes

# ── Block direct access to sensitive files ────────────────────
<FilesMatch "(^\.|\.(sql|log|env|json|lock|phar|md|xml|yml|yaml|sh|dist)$|^Dockerfile$|^Caddyfile$)">
    Require all denied
</FilesMatch>

# ── Block internal folders ────────────────────────────────────
# includes/ holds PHP fragments that are only ever required by pages;
# login_action.php is the one endpoint the login form posts to.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^includes/(?!login_action\.php$) - [F,L]
    RewriteRule ^(src|tests|vendor|database|docker|scripts|e2e|node_modules)(/|$) - [F,L]
</IfModule>
