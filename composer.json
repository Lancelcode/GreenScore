{
    "name": "lancelcode/greenscore",
    "description": "GreenScore: sustainability scoring and certification web application",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-mysqli": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "GreenScore\\": "src/" },
        "files": ["src/functions.php"]
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true
    }
}
