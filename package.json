{
  "name": "greenscore",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Sustainability scoring and certification for organisations (Next.js + TypeScript)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.mts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.4.0",
    "animate.css": "^4.1.1",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.3",
    "mysql2": "^3.24.6",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.63.0",
    "@types/bootstrap": "5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright-core": "1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
