# Copy to .env and adjust. .env is git-ignored — never commit real secrets.

# ── Database (used by the app) ───────────────────────────────
# With Docker Compose the host is the "db" service; for a local MySQL/MariaDB
# install use 127.0.0.1.
DB_HOST=db
DB_PORT=3306
DB_NAME=gradedunit
DB_USER=greenscore
DB_PASSWORD=change-me-app-password

# ── Database server (used only by the MariaDB container) ─────
DB_ROOT_PASSWORD=change-me-root-password

# ── App ──────────────────────────────────────────────────────
# Port on your machine where the site is published by docker compose.
APP_PORT=8080
# Show PHP errors in the browser. Keep 0 anywhere but your own machine.
APP_DEBUG=0
# Set to 1 only when running behind a reverse proxy (e.g. Caddy) that sets
# X-Forwarded-Proto, so secure cookies are used over HTTPS.
TRUST_PROXY=0
