# Copy to .env and adjust. .env is git-ignored — never commit real secrets.

# ── Database (used by the app) ───────────────────────────────
# With Docker Compose the host is the "db" service; for a local MySQL/MariaDB
# install use 127.0.0.1.
DB_HOST=db
DB_PORT=3306
DB_NAME=gradedunit
DB_USER=greenscore
DB_PASSWORD=change-me-app-password

# ── Database server (used only by the MariaDB container) ─────
DB_ROOT_PASSWORD=change-me-root-password

# ── App ──────────────────────────────────────────────────────
# Port on your machine where the site is published by docker compose.
APP_PORT=8080
# Set to 1 only when running behind a reverse proxy (e.g. Caddy) that sets
# X-Forwarded-Proto, so secure cookies are used over HTTPS.
TRUST_PROXY=0

# ── Hosted database (e.g. on Vercel) ─────────────────────────
# Hosted MySQL-compatible databases require encrypted connections.
# DB_SSL=1 turns on TLS with certificate checks. If your provider gives you
# a CA certificate, paste its contents into DB_SSL_CA ("\n" for new lines).
DB_SSL=0
DB_SSL_CA=
# Keep the pool small on serverless hosts with connection limits.
DB_POOL_SIZE=10

# ── Public demo ──────────────────────────────────────────────
# DEMO_MODE=1 shows one-click demo logins and a demo notice, protects the
# demo accounts, and enables the nightly reset at /api/cron/reset-demo.
DEMO_MODE=0
# Secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>".
# At least 16 characters; generate one with: openssl rand -hex 32
CRON_SECRET=
