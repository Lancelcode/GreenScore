# Production settings for the home server. Copy to .env on the server:
#   cp .env.production.example .env && chmod 600 .env
# Generate passwords with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# Use the production profile for every `docker compose` command.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ── Network ──────────────────────────────────────────────────
# The server's Tailscale IPv4 address (`tailscale ip -4`). Caddy listens only
# here, so GreenScore is reachable only from your tailnet.
BIND_ADDRESS=100.x.y.z
# Either the server's MagicDNS name for automatic HTTPS (needs HTTPS enabled
# in the Tailscale admin console), e.g. greenscore.tailXXXX.ts.net
# or plain HTTP inside the tailnet, e.g. http://greenscore
SITE_ADDRESS=greenscore.tailXXXX.ts.net

# ── Database ─────────────────────────────────────────────────
DB_NAME=gradedunit
DB_USER=greenscore
DB_PASSWORD=
DB_ROOT_PASSWORD=
# 1 = keep the demo accounts and data (e.g. a private portfolio demo).
# Only read the first time the database volume is created.
KEEP_DEMO_DATA=0

# ── Backups (scripts/backup-db.sh) ───────────────────────────
BACKUP_DIR=/var/backups/greenscore
RETENTION_DAYS=14
